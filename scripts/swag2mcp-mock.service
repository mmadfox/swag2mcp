[Unit]
Description=swag2mcp Mock Server
Documentation=https://github.com/mmadfox/swag2mcp
After=network.target

[Service]
Type=simple
# Default workspace: ~/.swag2mcp
# If your workspace is elsewhere, specify the path:
# ExecStart=/usr/bin/swag2mcp-mock /path/to/workspace
ExecStart=/usr/bin/swag2mcp-mock
Restart=on-failure
RestartSec=5
User=swag2mcp
Group=swag2mcp
AmbientCapabilities=
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

#!/bin/bash
# .githooks/pre-commit — adds Apache 2.0 SPDX header to staged .go files

HEADER='/*
 * SPDX-FileCopyrightText: © 2025-2026 Sergey "mmadfox" Liskonog
 * SPDX-License-Identifier: Apache-2.0
 */'

for f in $(git diff --cached --name-only --diff-filter=ACM | grep '\.go$'); do
    if [ ! -f "$f" ]; then
        continue
    fi
    if grep -q "SPDX-FileCopyrightText" "$f"; then
        continue
    fi
    printf '%s\n\n' "$HEADER" | cat - "$f" > "${f}.tmp" && mv "${f}.tmp" "$f"
    goimports -w "$f" 2>/dev/null
    git add "$f"
done
